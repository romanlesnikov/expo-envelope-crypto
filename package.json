{
  "name": "expo-envelope-crypto",
  "version": "0.1.0",
  "description": "Password-protected envelope encryption for React Native and the web: AES-256-GCM, a wrapped data key, and a KDF iteration count that can be raised without locking anyone out.",
  "type": "module",
  "license": "MIT",
  "author": "Roman Lesnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanlesnikov/expo-envelope-crypto.git"
  },
  "keywords": [
    "encryption",
    "aes-gcm",
    "pbkdf2",
    "envelope-encryption",
    "react-native",
    "expo",
    "local-first",
    "webcrypto"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.web.js",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependenciesMeta": {
    "expo-crypto": {
      "optional": true
    },
    "react-native-quick-crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
